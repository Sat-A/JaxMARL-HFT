# Aggressive PnL-oriented profile for generative world-model training.
# Load via: scripts/experiments/submit_genwm_profile.sh <this-file> <mode> --submit

# Core trainer
POLICY_ARCH=ippo_rnn
CHECKPOINT_RESTORE_TOPOLOGY=single-device-remap

# MM behavior (more expressive action space than bobStrategy)
MM_ACTION_SPACE=bobRL
MM_BOB_V0=10
MM_FIXED_QUANT_VALUE=10

# Optimizer / objective behavior
LR=3e-4
ENTROPY_COEF=5e-3
VALUE_COEF=0.5

# Common rollout/training settings
N_COND_MSGS=8
N_STEPS=32
N_UPDATES=20
SEED=42

# Smoke mode variables
N_ENVS=2

# Sweep mode variables
N_ENVS_CANDIDATES="1 2 4"
GPU_IDS="0"
MAX_PARALLEL_GPUS=1
RESUME_SWEEP=1
RETRY_PER_PROFILE=2

# Train-best mode variables
N_ENVS_BEST=2
